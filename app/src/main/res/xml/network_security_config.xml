<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext, and only the system's CAs: user-installed CAs are never trusted. telerouter's own CA is
     pinned in code (core/Trust.kt) for its LAN address only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
