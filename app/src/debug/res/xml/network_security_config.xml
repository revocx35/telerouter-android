<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (replaces the main config): also trust user-installed CAs, so the app can be tested on an
     emulator against a local telerouter behind a test proxy. Release builds use src/main's config (system CAs only). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
